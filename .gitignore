# PHP
*.log
*.cache
composer.lock

# Ignore PHP vendor (composer packages) but NOT Frontend/assets/vendor
/vendor/
Backend/vendor/

# Database
*.sql.backup
*.sql.gz

# Environment
.env
.env.local
.env.production

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
temp/
tmp/

# Ngrok
ngrok/
ngrok.exe
*.zip

# Uploads (if any)
uploads/*
!uploads/.gitkeep

# Session files
sessions/*
!sessions/.gitkeep

# Build files
node_modules/
dist/
build/

# Logs
logs/
*.log
error_log

# Database config (keep template only)
# Backend/config/database.php
Backend/config/database.local.php

# Sensitive files
# Scope these to real secret material instead of matching any filename that
# happens to contain the word. A bare *password* also swallowed the legitimate
# Frontend/pages/forgot-password.php page, so it never reached the live site.
*secret*
*password*.txt
*password*.json
*password*.sql
*password*.env
credentials.json
# One-time admin password-reset utility — never ship this to the live host.
update_admin_password.php
# ...but the password-recovery page is real source, not a secret.
!Frontend/pages/forgot-password.php

# Documentation and notes (local only)
QUICK_START.txt
CPANEL_*.txt
CPANEL_*.php
check_cpanel_directory.txt
UPDATED_HTACCESS.txt
cf.err.txt
cf.out.txt
cloudflared.exe
cloudflared2.exe

# Keep DEPLOYMENT_CHECKLIST.md but ignore other temp markdown
Analyze*.md

# Ignore server-modified files to prevent pull conflicts
busiaadmin.php
.htaccess

# Local documentation & skills — never push to GitHub
docs/
skills/
.freebuff/
